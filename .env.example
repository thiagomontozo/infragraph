INFRAGRAPH_ENV=development
INFRAGRAPH_HTTP_ADDR=:8080
INFRAGRAPH_DATABASE_URL=postgres://infragraph:infragraph@localhost:5432/infragraph?sslmode=disable
INFRAGRAPH_SESSION_SECRET=development-only-change-me-32-bytes
INFRAGRAPH_MASTER_KEY=
INFRAGRAPH_ALLOWED_ORIGINS=http://localhost:5173
INFRAGRAPH_OBJECT_STORAGE_TYPE=local
INFRAGRAPH_OBJECT_STORAGE_PATH=./data/objects
INFRAGRAPH_S3_ENDPOINT=localhost:9000
INFRAGRAPH_S3_BUCKET=infragraph
INFRAGRAPH_S3_ACCESS_KEY=
INFRAGRAPH_S3_SECRET_KEY=
INFRAGRAPH_S3_USE_TLS=false
INFRAGRAPH_MAX_GRAPH_DEPTH=6
INFRAGRAPH_MAX_GRAPH_NODES=500
INFRAGRAPH_MAX_IMPORT_BYTES=10485760
INFRAGRAPH_MAX_SNAPSHOT_BYTES=52428800
INFRAGRAPH_MAX_CONCURRENT_RECONCILIATIONS=4
INFRAGRAPH_COLLECTOR_HEARTBEAT_INTERVAL=30s
INFRAGRAPH_OTEL_ENABLED=false
INFRAGRAPH_OTEL_ENDPOINT=
INFRAGRAPH_TRUSTED_PROXY_CIDRS=
