INFRAGRAPH_ENV=development
INFRAGRAPH_HTTP_ADDR=:8080
INFRAGRAPH_DATABASE_URL=postgres://infragraph:infragraph@localhost:5432/infragraph?sslmode=disable
INFRAGRAPH_SESSION_SECRET=development-only-change-me-32-bytes
INFRAGRAPH_MASTER_KEY=
INFRAGRAPH_ALLOWED_ORIGINS=http://localhost:5173
INFRAGRAPH_OBJECT_STORAGE_TYPE=local
INFRAGRAPH_OBJECT_STORAGE_PATH=./data/objects
INFRAGRAPH_S3_ENDPOINT=localhost:9000
INFRAGRAPH_S3_BUCKET=infragraph
INFRAGRAPH_S3_ACCESS_KEY=
INFRAGRAPH_S3_SECRET_KEY=
INFRAGRAPH_S3_USE_TLS=false
INFRAGRAPH_MAX_GRAPH_DEPTH=6
INFRAGRAPH_MAX_GRAPH_NODES=500
INFRAGRAPH_MAX_IMPORT_BYTES=10485760
INFRAGRAPH_MAX_SNAPSHOT_BYTES=52428800
INFRAGRAPH_MAX_CONCURRENT_RECONCILIATIONS=4
INFRAGRAPH_COLLECTOR_HEARTBEAT_INTERVAL=30s
INFRAGRAPH_OTEL_ENABLED=false
INFRAGRAPH_OTEL_ENDPOINT=
INFRAGRAPH_TRUSTED_PROXY_CIDRS=
INFRAGRAPH_DEBUG=false

# Collector process only
INFRAGRAPH_CONTROL_PLANE_URL=http://localhost:8080
INFRAGRAPH_ENROLLMENT_TOKEN=
INFRAGRAPH_COLLECTOR_DATA_DIR=./data/collector
INFRAGRAPH_COLLECTOR_NAME=collector
INFRAGRAPH_CONNECTOR_NAME=Docker discovery
INFRAGRAPH_CONNECTOR_TYPE=DOCKER
INFRAGRAPH_COLLECTOR_INTERVAL=30s
INFRAGRAPH_COLLECTOR_MAX_SPOOL_BYTES=536870912
INFRAGRAPH_COLLECTOR_MAX_SPOOL_AGE=168h
INFRAGRAPH_DOCKER_SOCKET=/var/run/docker.sock
INFRAGRAPH_DOCKER_LABEL_SCOPE=com.infragraph.test=true
INFRAGRAPH_KUBERNETES_API_URL=https://kubernetes.default.svc
INFRAGRAPH_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
INFRAGRAPH_KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
INFRAGRAPH_KUBERNETES_CLUSTER_ID=
INFRAGRAPH_KUBERNETES_CLUSTER_NAME=
INFRAGRAPH_KUBERNETES_TIMEOUT=30s
INFRAGRAPH_KUBERNETES_PAGE_SIZE=500
INFRAGRAPH_KUBERNETES_MAX_RESOURCES=100000

