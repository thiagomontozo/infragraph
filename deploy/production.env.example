# Copy to .env.production outside version control and inject secrets from a
# secret manager. Compose image variables must be exported in the invoking
# shell (or supplied with --env-file) because they control interpolation.
INFRAGRAPH_API_IMAGE=ghcr.io/thiagomontozo/infragraph-api@sha256:REPLACE
INFRAGRAPH_WEB_IMAGE=ghcr.io/thiagomontozo/infragraph-web@sha256:REPLACE
INFRAGRAPH_ENV=production
INFRAGRAPH_HTTP_ADDR=:8080
INFRAGRAPH_DATABASE_URL=postgres://REPLACE@db.example.com/infragraph?sslmode=verify-full
INFRAGRAPH_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INFRAGRAPH_MASTER_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
INFRAGRAPH_ALLOWED_ORIGINS=https://inventory.example.com
INFRAGRAPH_OBJECT_STORAGE_TYPE=s3
INFRAGRAPH_S3_ENDPOINT=s3.example.com
INFRAGRAPH_S3_BUCKET=infragraph
INFRAGRAPH_S3_ACCESS_KEY=REPLACE
INFRAGRAPH_S3_SECRET_KEY=REPLACE
INFRAGRAPH_S3_USE_TLS=true
INFRAGRAPH_TRUSTED_PROXY_CIDRS=172.30.0.0/24
INFRAGRAPH_MAX_GRAPH_DEPTH=6
INFRAGRAPH_MAX_GRAPH_NODES=500
INFRAGRAPH_MAX_IMPORT_BYTES=10485760
INFRAGRAPH_MAX_SNAPSHOT_BYTES=52428800
INFRAGRAPH_MAX_CONCURRENT_RECONCILIATIONS=4
INFRAGRAPH_COLLECTOR_HEARTBEAT_INTERVAL=30s
INFRAGRAPH_OTEL_ENABLED=false
INFRAGRAPH_OTEL_ENDPOINT=
INFRAGRAPH_DEBUG=false
