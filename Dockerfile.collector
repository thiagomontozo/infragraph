FROM golang:1.26.6-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN --mount=type=secret,id=build_ca,required=false sh -c 'if [ -f /run/secrets/build_ca ]; then export SSL_CERT_FILE=/run/secrets/build_ca; fi; go mod download'
COPY . .
ARG VERSION=1.0.0-rc.1
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/infragraph-collector ./cmd/infragraph-collector

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/infragraph-collector /infragraph-collector
USER nonroot:nonroot
ENTRYPOINT ["/infragraph-collector"]
