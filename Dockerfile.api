FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN --mount=type=secret,id=build_ca,required=false sh -c 'if [ -f /run/secrets/build_ca ]; then export SSL_CERT_FILE=/run/secrets/build_ca; fi; go mod download'
COPY . .
ARG VERSION=1.0.0-rc.1
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/infragraph-api ./cmd/infragraph-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/infragraph-api /infragraph-api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/infragraph-api"]
